// HLA-Verify API — Cloudflare Worker (free plan: no containers, no cold Python).
// Data shards in ./public/data are generated by `python -m sci_envs.service.edge_export`
// and are NOT committed; run the exporter before `wrangler deploy`.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "hlaverify-api",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "api.hlaverify.com", "custom_domain": true },
    { "pattern": "hlaverify.com/v1/*", "zone_name": "hlaverify.com" },
    { "pattern": "www.hlaverify.com/v1/*", "zone_name": "hlaverify.com" }
  ],
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_STARTER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_PRO", "namespace_id": "1003", "simple": { "limit": 6000, "period": 60 } }
  ],
  // KV namespace for self-serve/tiered keys (record shape documented in
  // src/stripe.js). The overseer creates this once with
  // `wrangler kv namespace create KEYS` and pastes the returned id below,
  // replacing 8360bbe6d4904699ab019702427fc19d. Until then, env.KEYS is undefined and the API falls
  // back to secret-only keys (HLA_VERIFY_API_KEYS) plus anonymous free tier.
  "kv_namespaces": [
    { "binding": "KEYS", "id": "8360bbe6d4904699ab019702427fc19d" }
  ],
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "hlaverify_usage" }
  ],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_ACCESS": "1",
    // Maps a Stripe price id to a tier for self-serve key issuance (src/stripe.js),
    // used only when checkout.session.completed has no metadata.tier; anything not
    // listed here falls back to "starter". Example: {"price_123":"starter","price_456":"pro"}.
    "STRIPE_TIER_MAP": "{\"price_1UEZpKPULaK83987DPGNMPdD\": \"starter\", \"price_1UEZpLPULaK83987RyGL96dG\": \"pro\"}",
    // Stripe Payment Links shown as buttons on GET /pricing; each renders as
    // "coming soon" until set. Set metadata.tier on the underlying price (or on
    // the Payment Link itself) so the webhook can read session.metadata.tier.
    "STRIPE_STARTER_LINK": "https://buy.stripe.com/test_14A14p4GJ1pt5owcAdcZa00",
    "STRIPE_PRO_LINK": "https://buy.stripe.com/test_00wcN7ddf6JN4ks0RvcZa01"
  }
  // Secrets (wrangler secret put):
  //   HLA_VERIFY_API_KEYS = "key=label:tier,key2=label2:tier2" (tiers: starter, pro, enterprise)
  //   STRIPE_WEBHOOK_SECRET = "<the whsec_... signing secret from the Stripe webhook endpoint settings>"
  //   STRIPE_SECRET_KEY = "<a RESTRICTED Stripe API key: Checkout Sessions read, Customers write only>"
}
